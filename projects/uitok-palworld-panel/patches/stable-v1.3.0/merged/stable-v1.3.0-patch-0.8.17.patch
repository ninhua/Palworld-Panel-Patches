+	out := make([]string, 0)
+	for _, item := range strings.Split(value, ",") {
+		item = normalizeQuery(item)
+		if item == "" || seen[item] {
+			continue
+		}
+		seen[item] = true
+		out = append(out, item)
+	}
+	return out
