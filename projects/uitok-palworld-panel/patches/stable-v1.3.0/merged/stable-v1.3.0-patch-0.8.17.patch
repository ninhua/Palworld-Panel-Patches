+          status: { enabled: true, state: 'ready', stale: false, source_path: '/save', updated_at: '', duration_ms: 1, warnings: [], counts: { players: 1, guilds: 1, bases: 1, pals: 1, containers: 0, map_entities: 0 } },
+          source_id: 'server',
