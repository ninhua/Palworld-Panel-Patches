+          },
+          deleted: true,
+        },
+      },
+    });
+
+    const base = await basesApi.clearCustomName('base-1');
+
+    expect(remove).toHaveBeenCalledWith('/bases/base-1/name');
+    expect(base.has_custom_name).toBe(false);
+    expect(base.custom_name).toBe('');
