+import React, { useEffect, useMemo, useState } from 'react';
+import {
+  CheckSquare, Gift, LoaderCircle, PackagePlus, Plus, RefreshCw, RotateCcw, Save, Search, Square, Trash2,
+} from 'lucide-react';
+import { getErrorMessage } from '../api/client';
+import {
+  starterGiftApi,
+  type StarterGiftCatalogItem,
+  type StarterGiftConfig,
+  type StarterGiftItem,
+  type StarterGiftSnapshot,
+} from '../api/starterGift';
+
+const emptyConfig: StarterGiftConfig = {
+  enabled: false,
+  items: [],
+  pal_templates: [],
+  item_batch_size: 20,
+  template_batch_size: 5,
+  batch_delay_ms: 500,
+};
+
+const statusLabel = (status: string) => ({
+  pending: '等待发放', running: '正在分批发放', success: '发放完成', failed: '发放失败',
+}[status] || status);
+
+export const StarterGift: React.FC = () => {
+  const [snapshot, setSnapshot] = useState<StarterGiftSnapshot | null>(null);
+  const [config, setConfig] = useState<StarterGiftConfig>(emptyConfig);
+  const [itemSearch, setItemSearch] = useState('');
+  const [templateSearch, setTemplateSearch] = useState('');
+  const [busy, setBusy] = useState(false);
+  const [notice, setNotice] = useState('');
+
+  const load = async () => {
+    setBusy(true);
+    setNotice('');
+    try {
+      const next = await starterGiftApi.get();
+      setSnapshot(next);
+      setConfig(next.config);
+    } catch (error) {
+      setNotice(getErrorMessage(error));
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  useEffect(() => { void load(); }, []);
+
+  const templateNames = useMemo(
+    () => (snapshot?.templates || []).map((item) => item.name).filter(Boolean),
+    [snapshot],
+  );
+  const visibleTemplates = useMemo(() => {
+    const query = templateSearch.trim().toLowerCase();
+    if (!query) return templateNames;
+    return templateNames.filter((name) => name.toLowerCase().includes(query));
+  }, [templateNames, templateSearch]);
+  const visibleItems = useMemo(() => {
+    const query = itemSearch.trim().toLowerCase();
+    const catalog = snapshot?.item_catalog || [];
+    if (!query) return catalog.slice(0, 80);
+    return catalog.filter((item) => `${item.id} ${item.name}`.toLowerCase().includes(query)).slice(0, 80);
+  }, [snapshot, itemSearch]);
+  const allSelected = templateNames.length > 0 && templateNames.every((name) => config.pal_templates.includes(name));
+
+  const updateItem = (index: number, patch: Partial<StarterGiftItem>) => {
+    setConfig((current) => ({
+      ...current,
+      items: current.items.map((item, itemIndex) => itemIndex === index ? { ...item, ...patch } : item),
+    }));
+  };
+
+  const addCatalogItem = (catalogItem: StarterGiftCatalogItem) => {
+    setConfig((current) => {
+      if (current.items.some((item) => item.item_id === catalogItem.id)) return current;
+      return { ...current, items: [...current.items, { item_id: catalogItem.id, count: 1 }] };
+    });
+  };
+
+  const save = async () => {
+    setBusy(true);
+    setNotice('');
+    try {
+      const next = await starterGiftApi.save(config);
+      setSnapshot(next);
+      setConfig(next.config);
+      setNotice('配置已保存。系统会保留已有玩家基线，只给之后首次出现的新玩家发放。');
+    } catch (error) {
+      setNotice(getErrorMessage(error));
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  const retry = async (playerID: string) => {
+    setBusy(true);
+    setNotice('');
+    try {
+      await starterGiftApi.retry(playerID);
+      await load();
+      setNotice('已排队，将在下一次在线玩家检测时从未完成批次继续。');
+    } catch (error) {
+      setNotice(getErrorMessage(error));
+      setBusy(false);
+    }
+  };
+
+  const forget = async (playerID: string) => {
+    if (!window.confirm('重置该玩家的礼包记录？如果玩家仍在线，将等待其离线并重新进入后再发放。')) return;
+    setBusy(true);
+    setNotice('');
+    try {
+      await starterGiftApi.forget(playerID);
+      await load();
+      setNotice('记录已重置；玩家需要离线并重新进入后才会再次获得礼包。');
+    } catch (error) {
+      setNotice(getErrorMessage(error));
+      setBusy(false);
+    }
+  };
+
+  return (
+    <div className="page-shell">
+      <div className="page-titlebar">
+        <div>
+          <p className="eyebrow">New player onboarding</p>
+          <h1>新玩家初始礼包</h1>
+          <p>通过 PalDefender 给首次进入的新玩家分批发放物品和多个帕鲁模板。</p>
+        </div>
+        <button type="button" className="pp-button" onClick={() => void load()} disabled={busy}>
+          <RefreshCw size={15} />刷新
+        </button>
+      </div>
+
+      {notice && <div className="pp-notice">{notice}</div>}
+
+      <section className="pp-card">
+        <div className="pp-card-head">
+          <div>
+            <h2>发放策略</h2>
+            <p>第一次启用仅导入历史玩家基线，不会给当前或过去的老玩家补发。</p>
+          </div>
+          <Gift size={18} />
+        </div>
+        <label className="field-label">
+          <span><input type="checkbox" checked={config.enabled} onChange={(event: React.ChangeEvent<HTMLInputElement>) => setConfig({ ...config, enabled: event.target.checked })} /> 启用自动发放</span>
+        </label>
+        <div className="content-grid three-column">
+          <label className="field-label">物品每批条目数<input type="number" min={1} max={100} value={config.item_batch_size} onChange={(event: React.ChangeEvent<HTMLInputElement>) => setConfig({ ...config, item_batch_size: Number(event.target.value) })} /></label>
+          <label className="field-label">模板每批数量<input type="number" min={1} max={20} value={config.template_batch_size} onChange={(event: React.ChangeEvent<HTMLInputElement>) => setConfig({ ...config, template_batch_size: Number(event.target.value) })} /></label>
+          <label className="field-label">批次间隔（毫秒）<input type="number" min={100} max={10000} step={100} value={config.batch_delay_ms} onChange={(event: React.ChangeEvent<HTMLInputElement>) => setConfig({ ...config, batch_delay_ms: Number(event.target.value) })} /></label>
+        </div>
+      </section>
+
+      <div className="content-grid two-column">
+        <section className="pp-card">
+          <div className="pp-card-head">
+            <div><h2>初始物品</h2><p>已选择 {config.items.length} 种物品，可从 PalDefender 物品目录添加。</p></div>
+            <button type="button" className="pp-button" onClick={() => setConfig({ ...config, items: [...config.items, { item_id: '', count: 1 }] })}>
+              <Plus size={14} />手动添加
+            </button>
+          </div>
+          <label className="field-label">
+            搜索物品
+            <span className="relative">
+              <Search className="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400" size={15} />
+              <input className="pp-input pp-input--icon" value={itemSearch} onChange={(event: React.ChangeEvent<HTMLInputElement>) => setItemSearch(event.target.value)} placeholder="名称或 ItemID" />
+            </span>
+          </label>
+          {itemSearch.trim() && (
+            <div className="source-list">
+              {visibleItems.map((item) => (
+                <button type="button" className="source-row text-left" key={item.id} onClick={() => addCatalogItem(item)}>
+                  <PackagePlus size={17} />
+                  <div className="source-copy"><strong>{item.name}</strong><span>{item.id}</span></div>
+                </button>
+              ))}
+            </div>
+          )}
+          <div className="source-list">
+            {config.items.map((item, index) => (
+              <div className="source-row" key={`${index}-${item.item_id}`}>
+                <div className="source-copy">
+                  <input aria-label="ItemID" placeholder="例如 Money" value={item.item_id} onChange={(event: React.ChangeEvent<HTMLInputElement>) => updateItem(index, { item_id: event.target.value })} />
+                  <input aria-label="数量" type="number" min={1} max={2147483647} value={item.count} onChange={(event: React.ChangeEvent<HTMLInputElement>) => updateItem(index, { count: Number(event.target.value) })} />
+                </div>
+                <button type="button" className="icon-danger" aria-label="删除物品" onClick={() => setConfig({ ...config, items: config.items.filter((_, itemIndex) => itemIndex !== index) })}><Trash2 size={15} /></button>
+              </div>
+            ))}
+          </div>
+        </section>
+
+        <section className="pp-card">
+          <div className="pp-card-head">
+            <div><h2>PalDefender 帕鲁模板</h2><p>已选择 {config.pal_templates.length}/{templateNames.length} 个模板。</p></div>
+            <button type="button" className="pp-button" disabled={templateNames.length === 0} onClick={() => setConfig({ ...config, pal_templates: allSelected ? [] : [...templateNames] })}>
+              {allSelected ? <CheckSquare size={15} /> : <Square size={15} />}{allSelected ? '取消全选' : '全选'}
+            </button>
+          </div>
+          {snapshot?.template_error && <div className="pp-notice">模板读取失败：{snapshot.template_error}</div>}
+          <label className="field-label">搜索模板<input value={templateSearch} onChange={(event: React.ChangeEvent<HTMLInputElement>) => setTemplateSearch(event.target.value)} placeholder="模板名称" /></label>
+          <div className="source-list">
+            {visibleTemplates.map((name) => {
+              const checked = config.pal_templates.includes(name);
+              return (
+                <label key={name} className={`source-row ${checked ? 'active' : ''}`}>
+                  <input type="checkbox" checked={checked} onChange={() => setConfig({ ...config, pal_templates: checked ? config.pal_templates.filter((item) => item !== name) : [...config.pal_templates, name] })} />
+                  <div className="source-copy"><strong>{name}</strong></div>
+                </label>
+              );
+            })}
+          </div>
+        </section>
+      </div>
+
+      <section className="pp-card">
+        <div className="pp-card-head"><div><h2>发放记录</h2><p>每位玩家会冻结领取时的礼包计划；之后修改配置不会改变正在发放的批次。</p></div></div>
+        <div className="source-list">
+          {(snapshot?.grants || []).map((grant) => (
+            <article className="source-row" key={grant.player_id}>
+              <div className="source-copy">
+                <strong>{grant.nickname || grant.player_id}</strong>
+                <span>{statusLabel(grant.status)} · 物品 {grant.next_item}/{grant.item_total} · 模板 {grant.next_template}/{grant.template_total} · 尝试 {grant.attempts}</span>
+                {grant.last_error && <span className="candidate-error">{grant.last_error}</span>}
+              </div>
+              <div className="source-actions">
+                {grant.status === 'failed' && <button type="button" className="pp-button" disabled={busy} onClick={() => void retry(grant.player_id)}><RotateCcw size={14} />重试</button>}
+                <button type="button" className="icon-danger" aria-label="重置玩家礼包记录" disabled={busy} onClick={() => void forget(grant.player_id)}><Trash2 size={15} /></button>
+              </div>
+            </article>
+          ))}
+        </div>
+      </section>
+
+      <button type="button" className="pp-button accent wide" disabled={busy} onClick={() => void save()}>
+        {busy ? <LoaderCircle className="animate-spin" size={15} /> : <Save size={15} />}保存配置
+      </button>
+    </div>
+  );
+};
